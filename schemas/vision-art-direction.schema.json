{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["per_image", "set_diversity", "passed", "reason", "recommended_winner"],
  "properties": {
    "per_image": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image", "variety", "quality", "style_adherence", "food_appeal", "composition", "muffin_pan_form", "feedback"],
        "properties": {
          "image": {"type": "integer", "minimum": 1},
          "variety": {"type": "number", "minimum": 1, "maximum": 5},
          "quality": {"type": "number", "minimum": 1, "maximum": 5},
          "style_adherence": {"type": "number", "minimum": 1, "maximum": 5},
          "food_appeal": {"type": "number", "minimum": 1, "maximum": 5},
          "composition": {"type": "number", "minimum": 1, "maximum": 5},
          "muffin_pan_form": {"type": "number", "minimum": 1, "maximum": 5},
          "feedback": {"type": "string"}
        }
      }
    },
    "set_diversity": {"type": "number", "minimum": 1, "maximum": 5},
    "passed": {"type": "boolean"},
    "reason": {"type": "string"},
    "recommended_winner": {"type": "integer", "minimum": 1},
    "avg_score": {"type": "number", "minimum": 1, "maximum": 5}
  }
}
