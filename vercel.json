{
    "version": 2,
    "builds": [
        {
            "src": "backend/admin/app.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "50mb",
                "maxDuration": 300
            }
        },
        {
            "src": "src/**",
            "use": "@vercel/static"
        },
        {
            "src": "backend/admin/static/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "headers": {
                "X-Frame-Options": "DENY",
                "X-Content-Type-Options": "nosniff",
                "Referrer-Policy": "strict-origin-when-cross-origin",
                "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://*.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
            },
            "continue": true
        },
        {
            "src": "/(.*)",
            "headers": {
                "Location": "https://muffinpanrecipes.com/$1"
            },
            "has": [
                {
                    "type": "host",
                    "value": "www.muffinpanrecipes.com"
                }
            ],
            "status": 301
        },
        {
            "src": "/api/(.*)",
            "dest": "backend/admin/app.py"
        },
        {
            "src": "/admin/static/(.*)",
            "dest": "/backend/admin/static/$1"
        },
        {
            "src": "/admin/(.*)",
            "dest": "backend/admin/app.py"
        },
        {
            "src": "/auth/(.*)",
            "dest": "backend/admin/app.py"
        },
        {
            "src": "/health",
            "dest": "backend/admin/app.py"
        },
        {
            "src": "/this-week/?$",
            "dest": "backend/admin/app.py"
        },
        {
            "src": "/recipes/?$",
            "dest": "backend/admin/app.py"
        },
        {
            "src": "/recipes\\.json",
            "dest": "backend/admin/app.py"
        },
        {
            "src": "/sitemap\\.xml",
            "dest": "backend/admin/app.py"
        },
        {
            "src": "/recipes/([^/]+)$",
            "dest": "/src/recipes/$1/index.html",
            "check": true
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/recipes/([^/]+)$",
            "dest": "backend/admin/app.py"
        },
        {
            "src": "/blob-images/(.*)",
            "dest": "https://gtczmjysc51nh8fq.public.blob.vercel-storage.com/images/$1",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/assets/(.*)",
            "dest": "/src/assets/$1"
        },
        {
            "src": "/robots\\.txt",
            "dest": "/src/robots.txt"
        },
        {
            "src": "/about",
            "dest": "/src/about.html"
        },
        {
            "src": "/",
            "dest": "/src/index.html"
        },
        {
            "src": "/(.*)",
            "dest": "/src/404.html",
            "status": 404
        }
    ],
    "crons": [
        {
            "path": "/api/cron/monday",
            "schedule": "30 14 * * 1"
        },
        {
            "path": "/api/cron/tuesday",
            "schedule": "30 14 * * 2"
        },
        {
            "path": "/api/cron/wednesday",
            "schedule": "30 14 * * 3"
        },
        {
            "path": "/api/cron/thursday",
            "schedule": "30 14 * * 4"
        },
        {
            "path": "/api/cron/friday",
            "schedule": "30 14 * * 5"
        },
        {
            "path": "/api/cron/saturday",
            "schedule": "30 14 * * 6"
        },
        {
            "path": "/api/cron/sunday",
            "schedule": "0 0 * * 0"
        }
    ],
    "env": {
        "PYTHONPATH": "."
    }
}
